{
  "manifest_version": 3,
  "name": "Civify Resume Tailor",
  "version": "1.2.0",
  "description": "Mask PII and tailor your resume for job applications using Civify AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.civify.cv/*",
    "*://civify.cv/*",
    "*://stg.civify.cv/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*"
      ],
      "js": [
        "content/linkedin-scraper.js"
      ]
    }
  ]
}